<idea-plugin>
    <id>com.github.godark14.composerecompositionauditor</id>
    <name>Compose Recomposition Auditor</name>
    <vendor url="https://github.com/Godark14">Godark14</vendor>

    <description><![CDATA[
    Detects Jetpack Compose recomposition issues directly in the editor: unstable
    parameters, mutable collections passed to @Composable functions, and lambdas
    that capture mutable state without remember/rememberUpdatedState.
    Provides quick-fixes to stabilize composables and reduce unnecessary recompositions.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
            language="kotlin"
            displayName="Unstable parameter in @Composable function"
            groupName="Compose Recomposition Auditor"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.github.godark14.composerecompositionauditor.inspection.UnstableComposableParameterInspection"/>
    </extensions>
</idea-plugin>